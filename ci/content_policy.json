    "credential-assignment": "(?i)(?:password|passwd|api_key|access_token|authorization|cookie)\\s*[:=]\\s*[\"'](?!<|\\$\\{|example|placeholder|redacted)[a-z0-9/+=_.-]{20,}[\"']",
    "internal-host": "(?i)\\b[a-z0-9][a-z0-9.-]*\\.(?:internal|intranet|corp|local|sec\\.samsung\\.net)\\b",
    "private-ipv4": "(?<![\\w.])(?:10\\.\\d{1,3}\\.\\d{1,3}\\.\\d{1,3}|192\\.168\\.\\d{1,3}\\.\\d{1,3}|172\\.(?:1[6-9]|2\\d|3[01])\\.\\d{1,3}\\.\\d{1,3})(?![\\w.])",
    "private-ipv6": "(?i)(?<![\\w:])(?:f[cd][0-9a-f]{2}|fe80):[0-9a-f:]+",
    "perforce-path": "(?<![:/])//(?:SHARED|depot|[A-Za-z0-9_-]+/\\[[^\\]\\n]+\\])/"
  }
}
